# 使用 Playwright 官方镜像 (包含 Node.js 18+, Browsers, System Deps)
FROM mcr.microsoft.com/playwright:v1.49.0-jammy

# 1. 安装 Python 3.10 和基础工具
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3.10-venv \
    mysql-client \
    && rm -rf /var/lib/apt/lists/*

# 建立 python3 的软链接
RUN ln -s /usr/bin/python3.10 /usr/bin/python

# 2. [...](asc_slot://start-slot-1)设置工作目录
WORKDIR /app

# 3. 安装 Python 依赖 (FastAPI, Celery, SQLAlchemy 等)
COPY ./backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# 4. [...](asc_slot://start-slot-3)安装 Midscene CLI (Node.js 依赖)
# 这一步将 midscene 安装到全局，供 Python subprocess 调用
RUN npm install -g @midscene/cli @midscene/web tsx typescript @types/node playwright-core@1.49.0 @playwright/test
# 5. 关键：设置 NODE_PATH
# 这样你的 TS 脚本才能 require/import 到全局安装的包
ENV NODE_PATH=/usr/lib/node_modules
# 6. 创建报告存储目录
RUN mkdir -p /app/reports && chmod 777 /app/reports

# 设置 Python 路径
ENV PYTHONPATH=/app
